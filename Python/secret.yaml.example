# =====================================================================
# secret.yaml.example  --  voorbeeld voor Marijn
#
# Het algoritme-service-deployment hergebruikt het bestaande 'db-auth'
# Secret dat Vik's backend ook al gebruikt (zie zijn
# k8s/backend/base/deployment.yaml en overlays/productie/kustomization.yaml).
# Er is dus GEEN nieuw secret nodig.
#
# Dit bestand documenteert alleen welke keys het algoritme verwacht,
# zodat duidelijk is dat we 1-op-1 dezelfde keys lezen als de backend.
#
# In productie: NOOIT in Git committen. Maakt Marijn eenmalig handmatig
# in het cluster aan (kubectl create secret generic db-auth --from-literal=...).
# =====================================================================

apiVersion: v1
kind: Secret
metadata:
  name: db-auth
  namespace: energytruth-test   # of energytruth-productie
type: Opaque
stringData:
  DATABASE_IP: "REDACTED"
  DATABASE_PORT: "5432"
  POSTGRES_DB: "REDACTED"
  POSTGRES_USER: "REDACTED"
  POSTGRES_PASSWORD: "REDACTED"

# ---------------------------------------------------------------------
# Let op: dit Secret bevat ALLEEN credentials. De overige (niet-geheime)
# instellingen die de algoritme-worker kent, horen NIET in een Secret maar
# in de env van de worker-Deployment (of een ConfigMap). Ze hebben allemaal
# een verstandige default in de code, dus de pod draait ook zonder ze:
#   DB_SSLMODE                    (default prefer; zet op require zodra SSL aan staat)
#   DATABASE_CONNECT_TIMEOUT      (default 10  - seconden)
#   DATABASE_STATEMENT_TIMEOUT_MS (default 60000 - ms)
#   POLL_INTERVAL_SECONDS         (default 30  - polling-interval worker)
#   LOG_LEVEL                     (default INFO - DEBUG/INFO/WARNING/ERROR)
# Zie .env.example voor de volledige beschrijving van deze variabelen.
# ---------------------------------------------------------------------

---
# =====================================================================
# Tweede Secret: SMTP-credentials voor de rapport-mailer (mailer.py).
# Alleen SMTP_USER + SMTP_PASS zijn geheim (de Brevo SMTP-login). De overige
# mail-instellingen (SMTP_HOST, SMTP_PORT, MAIL_FROM, MAIL_FROM_NAME,
# MAIL_SUBJECT, REQUIRE_VERIFIED) zijn config en horen in de env van de
# mailer-job (of een ConfigMap), NIET in dit Secret.
# Aanmaken: kubectl create secret generic smtp-auth --from-literal=...
# =====================================================================
apiVersion: v1
kind: Secret
metadata:
  name: smtp-auth
  namespace: energytruth-test   # of energytruth-productie
type: Opaque
stringData:
  SMTP_USER: "REDACTED"
  SMTP_PASS: "REDACTED"
