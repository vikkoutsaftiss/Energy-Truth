# =====================================================================
# .env.example  --  Energy-Truth algoritme service
#
# Kopieer naar .env en vul de waardes in. .env is via .gitignore
# uitgesloten van Git.
#
# Lokale modus (VPN naar self-hosted PostgreSQL):
#   - DATABASE_IP wordt het interne IP van de DB-pod of -node
#   - Marijn geeft de waardes door
#
# Kubernetes-modus:
#   - .env wordt NIET gebruikt
#   - dezelfde variabelen worden geinjecteerd uit het Secret 'db-auth'
#     (zie k8s/secret.yaml.example en Vik's k8s/backend/base/deployment.yaml)
# =====================================================================

DATABASE_IP=<<vul in: bv. 10.244.0.42>>
DATABASE_PORT=5432
POSTGRES_DB=<<vul in: bv. energytruth>>
POSTGRES_USER=<<vul in: bv. energytruth_app>>
POSTGRES_PASSWORD=<<vul in: door Marijn aangeleverd>>

# SSL-modus voor de DB-verbinding.
#   prefer      = versleutel als de server het aanbiedt, anders plat (standaard, breekt niks)
#   require     = forceer versleuteling (zet dit ZODRA de server SSL aan heeft)
#   verify-full = versleuteling + certificaatcontrole (vergt CA-cert van Marijn)
# Zie Security_bevinding_DB-versleuteling.md voor de afweging.
DB_SSLMODE=prefer

# DB-timeouts (optioneel; dit zijn de code-defaults).
#   DATABASE_CONNECT_TIMEOUT      = seconden wachten op een verbinding (default 10)
#   DATABASE_STATEMENT_TIMEOUT_MS = server-side limiet per query in ms (default 60000)
# Voorkomt dat een onbereikbare DB of een hangende query de worker blokkeert.
DATABASE_CONNECT_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT_MS=60000

# Pollinggedrag van de worker (alleen relevant in worker-mode)
POLL_INTERVAL_SECONDS=30

# Log-verbosity (door scenario_engine uitgelezen): DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Rapport-mailer (mailer.py) - verstuurt de PDF via SMTP-relay (Brevo).
# SMTP_USER en SMTP_PASS zijn GEHEIM: in k8s uit een Secret (bv. smtp-auth),
# nooit in Git. De rest is gewone config (mag in Deployment-env/ConfigMap).
# ---------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<<vul in: Brevo SMTP-login (GEHEIM)>>
SMTP_PASS=<<vul in: Brevo SMTP-sleutel (GEHEIM)>>

# Afzender + onderwerp van de mail.
MAIL_FROM=<<vul in: bv. rapporten@mierlofirst.org>>
MAIL_FROM_NAME=Energy-Truth
MAIL_SUBJECT=Uw Energy-Truth simulatierapport

# Alleen mailen naar geverifieerde adressen (Klant.Email_verifieerd)? true/false
REQUIRE_VERIFIED=false
