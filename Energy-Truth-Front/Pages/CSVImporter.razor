@page "/csvimporter"
@using Energy_Truth.Shared;
@using CsvHelper;
@using System.Globalization;
@using System.Text.Json;
@using Energy_Truth_Presentation.Components;
@using Energy_Truth.Shared.Providers;
@using CsvHelper.Configuration;
@inject HttpClient Http
@inject IDialogService DialogService
@inject IEnumerable<IEnergyProvider> EnergyProviders

<PageTitle>Energie Data Import</PageTitle>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>
        <strong>Oeps!</strong> @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
    </div>
}

@{
    var providerNames = EnergyProviders.Select(p => p.Name).ToList();
    providerNames.Add("Handmatige invoer");
}

<MudSelect T="string" Label="Kies je provider" Placeholder="Kies een provider..." @Value="selectedProvider" ValueChanged="OnProviderSelected">
    @foreach (var provider in providerNames)
    {
        <MudSelectItem Value="@provider">@provider</MudSelectItem>
    }
    
</MudSelect>

@if (selectedProvider != null)
{
    <MudGrid>
        <MudItem>
            <div class="row">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><i class="bi bi-file-earmark-arrow-up"></i> Upload Energiegegevens</h4>
                    </div>
                    <div class="card-body">
                        <p>Stap 1: Selecteer je CSV-bestand</p>
                        <div class="input-group mb-3">
                            <InputFile OnChange="OnFileSelected" class="form-control" accept=".csv" />
                        </div>

                        @if (loading && !csvHeaders.Any())
                        {
                            <div class="text-center my-3">
                                <div class="spinner-border text-primary" role="status"></div>
                                <p>Headers inladen...</p>
                            </div>
                        }
                    </div>
                    <div class="px-3 pb-3">
                        <ExplanationFileUpload />
                    </div>
                </div>

                @if (csvHeaders.Any() && energyDataList == null)
                {
                    <div class="card shadow mt-4">
                        <div class="card-body">
                            <h5>Stap 2: Koppel de kolommen</h5>
                            <div class="row">
                                @foreach (var key in userMapping.Keys.ToList())
                                {
                                    <div class="col-md-6 mb-2">
                                        <label class="form-label fw-bold">@displayNames[key]</label>
                                        <select class="form-select" @bind="userMapping[key]">
                                            <option value="">-- Kies kolom --</option>
                                            @foreach (var header in csvHeaders)
                                            {
                                                <option value="@header">@header</option>
                                            }
                                        </select>
                                    </div>
                                }
                            </div>
                            <div class="mt-3">
                                <button class="btn btn-primary" @onclick="ProcessImport" disabled="@loading">
                                    @if (loading)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    Inlezen en Verwerken
                                </button>
                            </div>
                        </div>
                        <div class="px-3 pb-3">
                            <ExplanationCSVImporter />
                        </div>
                    </div>
                }

                @if (energyDataList != null)
                {
                    <div class="mt-4">
                        <div class="alert alert-success">Succes! @energyDataList.Count records ingeladen.</div>
                        <h5>Preview (Eerste 20)</h5>
                        <div class="table-responsive" style="max-height: 400px;">
                            <table class="table table-sm table-striped border">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Tijd</th>
                                        <th>Import kWh normaal tarief</th>
                                        <th>Import kWh dal tarief</th>
                                        <th>Export kWh normaal tarief</th>
                                        <th>Export kWh dal tarief</th>
                                        <th>Fase 1 maximale belasting</th>
                                        <th>Fase 2 maximale belasting</th>
                                        <th>Fase 3 maximale belasting</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in energyDataList.Take(20))
                                    {
                                        <tr>
                                            <td>@(item.Time?.ToString("dd-MM-yyyy HH:mm") ?? "-")</td>
                                            <td>@item.ImportT1</td>
                                            <td>@item.ImportT2</td>
                                            <td>@item.ExportT1</td>
                                            <td>@item.ExportT2</td>
                                            <td>@item.L1MaxW</td>
                                            <td>@item.L2MaxW</td>
                                            <td>@item.L3MaxW</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3 text-end">
                            <button class="btn btn-success btn-lg" @onclick="StartCalculation" disabled="@loading">
                                <i class="bi bi-calculator"></i> Start Berekening
                            </button>
                        </div>
                    </div>
                }

                @if (calculatedResult != null)
                {
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center">
                                    <h5>Totaal Import</h5>
                                    <h3>@calculatedResult.TotalImportKwh.ToString("N2") kWh</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-success text-white">
                                <div class="card-body text-center">
                                    <h5>Totaal Export</h5>
                                    <h3>@calculatedResult.TotalExportKwh.ToString("N2") kWh</h3>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </MudItem>
    </MudGrid>
}


    

@code {
    private List<string> csvHeaders = new();
    private Dictionary<string, string> userMapping = new();
    private Dictionary<string, string> displayNames = new();    
    private IBrowserFile? selectedFile;
    private List<EnergyImportDTO>? energyDataList;
    private bool loading = false;
    private CalculationResultDTO? calculatedResult;
    private string? errorMessage;
    private string? selectedProvider;
    private IEnergyProvider? Provider;


    private void OnProviderSelected(string? provider)
    {
        if (provider != null && provider != "Handmatige invoer")
        {
            Provider = EnergyProviders.FirstOrDefault(p => p.Name == provider);            
        }
        else
        {
            Provider = null;
        }
        selectedProvider = provider;

    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        csvHeaders.Clear();
        energyDataList = null;

        using var stream = selectedFile.OpenReadStream(maxAllowedSize: 1024 * 1024 * 10);
        using var reader = new StreamReader(stream);
            
        var headerLine = await reader.ReadLineAsync();

        if (Provider == null)
        {
            var delimiter = DetectDelimiter(headerLine ?? string.Empty);

            csvHeaders = headerLine?.Split(delimiter).ToList() ?? new List<string>();

            displayNames = typeof(EnergyImportDTO)
                .GetProperties()
                .ToDictionary(p => p.Name, p => p.Name);

            userMapping = typeof(EnergyImportDTO)
                .GetProperties()
                .ToDictionary(p => p.Name, p => "");
        }
        else
        {
            try
            {
                if (string.IsNullOrEmpty(headerLine))
                {
                    errorMessage = "Het CSV-bestand bevat geen headers.";
                    return;
                }

                if (Provider.StripRowQuotes)
                {
                    headerLine = headerLine.Trim('"');
                }

                csvHeaders = headerLine.Split(Provider.Delimiter).ToList();

                displayNames = Provider.DisplayNames;

                userMapping = Provider.CsvMapping.ToDictionary(k => k.Key, k => "");

                AutoMapHeaders();
            }
            catch (Exception ex)
            {
                errorMessage = $"Fout bij lezen headers: {ex.Message}";
            }
        }

        
    }

    private async Task ProcessImport()
    {
        if (selectedFile == null) return;

        loading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            using var content = new MultipartFormDataContent();
            var fileStream = selectedFile.OpenReadStream(1024 * 1024 * 10);
            content.Add(new StreamContent(fileStream), "file", selectedFile.Name);
            content.Add(new StringContent(JsonSerializer.Serialize(userMapping)), "mapping");
            content.Add(new StringContent(selectedProvider), "provider");

            var response = await Http.PostAsync("api/Import/csv", content);

            if (response.IsSuccessStatusCode)
            {
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                energyDataList = await response.Content.ReadFromJsonAsync<List<EnergyImportDTO>>(options);
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Fout bij verwerken: {ex.Message}";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private void AutoMapHeaders()
    {
        foreach (var key in userMapping.Keys.ToList())
        {
            var match = csvHeaders.FirstOrDefault(h =>
                h.Equals(key, StringComparison.OrdinalIgnoreCase) ||
                (displayNames.ContainsKey(key) && h.Equals(displayNames[key], StringComparison.OrdinalIgnoreCase)) ||
                (Provider.CsvMapping.ContainsKey(key) && h.Equals(Provider.CsvMapping[key], StringComparison.OrdinalIgnoreCase))
            );
            if (match != null) userMapping[key] = match;
        }
    }

    private async Task StartCalculation()
    {
        if (energyDataList == null || !energyDataList.Any()) return;

        loading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var response = await Http.PostAsJsonAsync($"api/Import/calculate/{selectedProvider}", energyDataList);

            if (response.IsSuccessStatusCode)
            {
                calculatedResult = await response.Content.ReadFromJsonAsync<CalculationResultDTO>(options);
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Fout bij berekening: {ex.Message}";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
        
    }

    private char DetectDelimiter(string headerLine)
    {
        var delimiters = new[] { ',', ';', '\t' };
        return delimiters.OrderByDescending(d => headerLine.Count(c => c == d)).FirstOrDefault();
    }
}