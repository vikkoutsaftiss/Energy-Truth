@page "/buildinglist"
@using Energy_Truth_Presentation.Services
@using Energy_Truth.Shared.DTO_s
@using Energy_Truth.Shared.Extensions
@using Energy_Truth.Shared.EnergyLabel
@inject HttpClient HttpClient
@inject IAuthenticateService AuthService
@inject NavigationManager NavigationManager

@if (AuthService.CurrentUser == null)
{
    NavigationManager.NavigateTo("/building");
}


<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">

    <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: 700;">Jouw woningoverzicht</MudText>
    <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: 700;" Class="mb-4">Selecteer de juiste woning om door te gaan.</MudText>

    @foreach (BuildingDTO building in _buildings)
    {
        <MudCard Class="mb-3">
            <MudCardContent>
                <MudText><strong>Postcode:</strong> @building.PostalCode</MudText>
                <MudText><strong>Bouwjaar:</strong> @building.ConstructionYear</MudText>
                <MudText><strong>Energielabel:</strong> @(Enum.Parse<ISTEnergyLabel>(building.ISTEnergyLabel).ToDisplayString())</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="@(() => NavigationManager.NavigateTo($"/batteryoverview/{building.Id}"))">
                    Selecteer
                </MudButton>
            </MudCardActions>
        </MudCard>
    }

    <MudDivider Class="my-4" />
    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Dark" Class="mb-2">
        Staat de juiste woning er niet tussen?
    </MudText>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               OnClick="@(() => NavigationManager.NavigateTo($"/building?skipRedirect=true"))">
        Woning toevoegen
    </MudButton>

</MudContainer>


@code {

    private List<BuildingDTO> _buildings = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.CurrentUser != null)
        {

            var response = await HttpClient.GetAsync($"api/building/getbuildingsbycustomerid/{AuthService.CurrentUser.Id}");
            if (response.IsSuccessStatusCode)
            {
                _buildings = await response.Content.ReadFromJsonAsync<List<BuildingDTO>>();                
            }
        }
    }
}
