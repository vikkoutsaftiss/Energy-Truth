@page "/batteryoverview/{BuildingId:int}"
@using Energy_Truth_Presentation.Services
@using Energy_Truth.Shared.Login
@using Energy_Truth.Shared.EnergyLabel
@using Energy_Truth.Shared.DTO_s
@using Energy_Truth.Shared.Extensions
@inject HttpClient HttpClient
@inject IAuthenticateService AuthService
@inject NavigationManager NavigationManager


@if (AuthService.CurrentUser == null)
{
    NavigationManager.NavigateTo("/building");
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
}


<MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: 700;">Hieronder staan alle batterijen weergeven welke wij meenemen in de berekening van jouw adviesrapport.</MudText>
<MudExpansionPanels Class="mt-4">
    <MudExpansionPanel Text="Batterij niet gevonden? Klik hier om de informatie toe te voegen!">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Productnaam" @bind-Value="_customBattery.ProductName" HelperText="Optioneel" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="decimal" Label="Capaciteit (kWh) *" @bind-Value="_customBattery.CapacityKWh" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="decimal" Label="Aanschafprijs (€) *" @bind-Value="_customBattery.Price" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="decimal?" Label="Round-trip rendement (0-1)" 
                @bind-Value="_customBattery.RoundTripEfficiency" 
                HelperText="Standaard 0,90" 
                Validation="EfficiencyValidation"/>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="decimal?" Label="Max laadsnelheid (kW)" 
                    @bind-Value="_customBattery.MaxChargePower" 
                    HelperText="Standaard 2,5 kW" 
                    Validation="ChargePowerValidation"/>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="decimal?" Label="Max ontlaadsnelheid (kW)" 
                    @bind-Value="_customBattery.MaxDischargePower" 
                    HelperText="Standaard 0,8 kW" 
                    Validation="DischargePowerValidation"/>
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Class="mt-2">* Verplicht</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="SaveCustomBattery"
                   Disabled="@(_customBattery.CapacityKWh == 0 || _customBattery.Price == 0)">
            Opslaan
        </MudButton>        
        @if (_customBatterySaved)
        {
            <MudAlert Severity="Severity.Success" Class="mt-3">
                Batterij opgeslagen — wordt meegenomen in de berekening.
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2"
                       OnClick="@(() => NavigationManager.NavigateTo($"/csvimporter/{BuildingId}"))">
                Doorgaan naar import
            </MudButton>
        }
    </MudExpansionPanel>
</MudExpansionPanels>

<MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="mt-3"
           OnClick="@(() => NavigationManager.NavigateTo($"/csvimporter/{BuildingId}"))">
    Doorgaan zonder custom batterij
</MudButton>

<MudGrid>
    @foreach (BatteryDTO battery in _batteries)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="mb-3" Style="height: 100%;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6"><strong>@battery.ProductName</strong></MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText><strong>Capaciteit in kWh: </strong> @battery.CapacityKWh</MudText>
                    <MudText><strong>Prijs: €</strong> @battery.Price</MudText>
                    <MudText><strong>Gegarandeerd aantal laadcycli: </strong> @battery.GuaranteedCycles</MudText>
                    <MudText><strong>Garantie in jaren: </strong> @battery.WarrantyPeriodYears</MudText>
                    <MudText><strong>Maximale laadsnelheid in kW: </strong> @battery.MaxChargePower</MudText>
                    <MudText><strong>Maximale ontlaadsnelheid in kW: </strong> @battery.MaxDischargePower</MudText>
                    @if (battery.InstallationCost == 0)
                    {
                        <MudText><strong>Installatiekosten: Geen installatiekosten!</strong></MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

    @code {
    private List<BatteryDTO> _batteries = new();
    private Func<decimal?, string?> EfficiencyValidation => v => ValidateRange(v, 0, 1);
    private Func<decimal?, string?> ChargePowerValidation => v => ValidateRange(v, 0, 22);
    private Func<decimal?, string?> DischargePowerValidation => v => ValidateRange(v, 0, 22);
    private CustomBatteryDTO _customBattery = new()
        {
            RoundTripEfficiency = 0.90m,
            MaxChargePower = 2.5m,
            MaxDischargePower = 0.8m
        };
    private BatteryDTO _newBattery = new();
    private string? _errorMessage;
    private bool _customBatterySaved;
    [Parameter]
    public int BuildingId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var response = await HttpClient.GetAsync($"api/battery/getbatteries");
        if (response.IsSuccessStatusCode)
        {
            _batteries = await response.Content.ReadFromJsonAsync<List<BatteryDTO>>();
            if (_batteries == null)
            {
                _batteries = new List<BatteryDTO>();
                _errorMessage = "Er zijn geen batterijen gevonden.";
            }
        }
       
    }

    private void SaveCustomBattery()
    {
        AuthService.CustomBattery = _customBattery;
        _customBatterySaved = true;
    }

    private string? ValidateRange(decimal? value, decimal min, decimal max)
    {
        if (value == null) return null;
        return value >= min && value <= max ? null : $"Waarde moet tussen {min} en {max} liggen";
    }

    
}
