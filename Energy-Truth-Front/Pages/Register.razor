@page "/register"
@using Energy_Truth_Presentation.Services
@using Energy_Truth.Shared.Login
@using Energy_Truth.Shared.DTO_s
@using Energy_Truth_Presentation.ViewModels

@inject IAuthenticateService AuthService
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager

@if (AuthService.CurrentUser != null)
{
    NavigationManager.NavigateTo("/buildinglist");
}

<MudText Typo="Typo.h2" Align="Align.Center" Style="font-weight: 700;">Registreer je bij Energy-Truth</MudText>

@if (!string.IsNullOrEmpty(SuccessMessage))
{
    <MudAlert Severity="Severity.Success">@SuccessMessage</MudAlert>
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <MudAlert Severity="Severity.Error" Elevation="1" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => ErrorMessage = null">
        <strong>Oeps!</strong> @ErrorMessage
    </MudAlert>
}

<MudForm @ref="_form">

    <div data-testid="email-field">
        <MudTextField T="string"
                      Label="Email"
                      InputType="InputType.Email"
                      Variant="Variant.Outlined"
                      @bind-Value="RegisterRequest.Email"
                      For="@(() => RegisterRequest.Email)"/>
    </div>

    <div data-testid="username-field">
        <MudTextField T="string"
                      Label="Name"
                      Variant="Variant.Outlined"
                      @bind-Value="RegisterRequest.Name"
                      InputType="InputType.Text"
                      For="@(() => RegisterRequest.Name)"/>
    </div>



    <div data-testid="password-field">
        <MudTextField T="string"
                      Label="Wachtwoord"
                      Variant="Variant.Outlined"
                      @bind-Value="RegisterRequest.Password"
                      InputType="@PasswordInput"
                      Adornment="Adornment.End"
                      AdornmentAriaLabel="Toggle Password Visibility"
                      OnAdornmentClick="TogglePasswordVisibility"
                      AdornmentIcon="@PasswordVisibilityIcon"
                      For="@(() => RegisterRequest.Password)"/>
    </div>

    <div data-testid="passwordconfirm-field">
        <MudTextField T="string"
                      Label="Bevestig Wachtwoord"
                      Variant="Variant.Outlined"
                      @bind-Value="RegisterRequest.ConfirmPassword"
                      InputType="@PasswordInput"
                      Adornment="Adornment.End"
                      AdornmentAriaLabel="Toggle Password Visibility"
                      OnAdornmentClick="TogglePasswordVisibility"
                      AdornmentIcon="@PasswordVisibilityIcon" 
                      For="@(() => RegisterRequest.ConfirmPassword)"/>
    </div>

    <div data-testid="address-field">
        <MudTextField T="string"
                      Label="Adres"
                      Variant="Variant.Outlined"
                      @bind-Value="RegisterRequest.Address"
                      InputType="InputType.Text" 
                      For="@(() => RegisterRequest.Address)"/>
    </div>

    <div data-testid="register-button">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   Class="mt-4"
                   @onclick="@HandleUserRegistration">
            Registreren
        </MudButton>
    </div>
</MudForm>

@code {

    private CreateCustomerDTO RegisterRequest { get; set; } = new();
    private bool isPasswordVisible;
    private InputType PasswordInput = InputType.Password;
    private string PasswordVisibilityIcon = Icons.Material.Filled.VisibilityOff;
    private string ErrorMessage = null;
    private string SuccessMessage = null;
    private MudForm _form;

    private void TogglePasswordVisibility()
    {
        isPasswordVisible = !isPasswordVisible;
        PasswordInput = isPasswordVisible ? InputType.Text : InputType.Password;
        PasswordVisibilityIcon = isPasswordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private async Task HandleUserRegistration()
    {
        await _form.Validate();
        if (!_form.IsValid) return;

        if (string.IsNullOrWhiteSpace(RegisterRequest.Email) || string.IsNullOrWhiteSpace(RegisterRequest.Password) || string.IsNullOrWhiteSpace(RegisterRequest.ConfirmPassword))
        {
            // Show an error message to the user (this can be done using a Snackbar or similar component)
            ErrorMessage = "Alle velden dienen ingevuld te zijn";
            return;
        }

        if (RegisterRequest.Password != RegisterRequest.ConfirmPassword)
        {
            ErrorMessage = "Wachtwoord en bevestiging komen niet overeen.";
            return;
        }

        var result = await HttpClient.PostAsJsonAsync("api/authentication/register", RegisterRequest);

        if (result.IsSuccessStatusCode)
        {
            SuccessMessage = "Registratie geslaagd!";
            StateHasChanged();
            await Task.Delay(2000);
            NavigationManager.NavigateTo("/buildinglist");
            
        }
        else
        {
            var message = await result.Content.ReadAsStringAsync();
            ErrorMessage = message;
        }
    }
}

