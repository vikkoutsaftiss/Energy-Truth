@page "/building"
@using Energy_Truth_Presentation.Services
@using Energy_Truth.Shared.Login
@using Energy_Truth.Shared.EnergyLabel
@using Energy_Truth.Shared.DTO_s
@using Energy_Truth.Shared.Extensions
@inject IAuthenticateService AuthService
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager 

@if (AuthService.CurrentUser == null)
{
    NavigationManager.NavigateTo("/login");
}


<MudText Typo="Typo.h2" Align="Align.Center" Style="font-weight: 700;">Welkom @AuthService.CurrentUser?.Email</MudText>

<MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: 700;">Vul hieronder de gegevens van je woning in.</MudText>


@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <MudAlert Severity="Severity.Error" Elevation="1" Dense="true" Class="mb-3"
              ShowCloseIcon="true" CloseIconClicked="() => ErrorMessage = null">
        <strong>Oeps!</strong> @ErrorMessage
    </MudAlert>
}

<MudForm @ref="_form">

        <div data-testid="postalcode-field">
            <MudTextField T="string"
                          Label="Postcode"
                          Variant="Variant.Outlined"
                          @bind-Value="_building.PostalCode"
                          InputType="InputType.Text" 
                          For="@(() => _building.PostalCode)" />


        </div>

        <div data-testid="buildyear-field">
            <MudTextField T="string"
                          Label="Bouwjaar"
                          Variant="Variant.Outlined"
                          @bind-Value="_building.ConstructionYear"
                          InputType="InputType.Number" 
                          For="@(() => _building.ConstructionYear)" />
        </div>

        <MudSelect T="ISTEnergyLabel"
                   Label="Energielabel"
                   @bind-Value="_building.ISTEnergyLabel"
                   ToStringFunc="@(label => label.ToDisplayString())">
            @foreach (var label in Enum.GetValues<ISTEnergyLabel>())
            {
                <MudSelectItem Value="label">@label.ToString()</MudSelectItem>
            }
        </MudSelect>

        <div data-testid="submit-button">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Class="mt-4"
                       @onclick="@HandleSubmit">
                Sla gebouw op
            </MudButton>
        </div>
</MudForm>

    @code {
    private CreateBuildingDTO _building = new CreateBuildingDTO();    
    private MudForm _form;
    private string ErrorMessage = "";
    [SupplyParameterFromQuery]
    private bool SkipRedirect { get; set; }


    protected override async Task OnInitializedAsync()
    {
        if (AuthService.CurrentUser != null && !SkipRedirect)
        {
            _building.CustomerId = AuthService.CurrentUser.Id;

            var response = await HttpClient.GetAsync($"api/building/getbuildingsbycustomerid/{AuthService.CurrentUser.Id}");
            if (response.IsSuccessStatusCode)
            {
                var buildings = await response.Content.ReadFromJsonAsync<List<BuildingDTO>>();
                if (buildings != null && buildings.Any())
                {
                    NavigationManager.NavigateTo("/buildinglist");
                }
            }
        }
    }

    private async Task HandleSubmit()
    {

        try
        {           

            if (!int.TryParse(_building.ConstructionYear, out _))
            {
                throw new ArgumentException("Bouwjaar moet een geldig jaartal zijn.");
            }
            
            var response = await HttpClient.PostAsJsonAsync("api/building/createbuilding", _building);
            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/buildinglist");
            }
            else
            {
                ErrorMessage = "Er is een fout opgetreden bij het opslaan van het gebouw.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Er is een fout opgetreden: {ex.Message}";
        }
    }
}