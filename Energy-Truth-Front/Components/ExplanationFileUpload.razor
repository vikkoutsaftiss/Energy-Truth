@using MudBlazor
@using MudBlazor.Components


<MudExpansionPanels MultiExpansion="true">
    
    <MudExpansionPanel Text="Hoe kom ik aan dit CSV bestand?">
        Het benodigde CSV bestand kan worden verkregen via de HomeWizard app. Klik op de "Exporteren" optie in de app en selecteer vervolgens "CSV". Het bestand zal worden gedownload naar uw apparaat, klaar om te worden geüpload naar deze applicatie. Klik <b>hier</b> voor extra uitleg.
    </MudExpansionPanel>
    <MudExpansionPanel Text="CSV bestand selecteren en uploaden">
        Om het CSV-bestand te uploaden, klikt u op de "Bestand kiezen" knop en selecteert u het gewenste CSV-bestand van uw computer. Nadat u het bestand heeft geselecteerd, klikt u op de "Uploaden" knop om het bestand naar de server te verzenden.
    </MudExpansionPanel>
    
</MudExpansionPanels>

