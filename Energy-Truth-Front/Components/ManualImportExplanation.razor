@using MudBlazor

<MudGrid Class="mt-4 mb-6" Style="align-items: stretch;"> 
    <MudItem xs="12" sm="6" md="3" Style="display: flex;">
        <MudPaper Elevation="0" Style="background-color: #fff8e1; border-radius: 12px; padding: 24px; width: 100%; height: 100%;">
            <MudIcon Icon="@Icons.Material.Filled.Language" Style="color: #f59e0b; font-size: 2rem;" />
            <MudText Typo="Typo.h6" Style="font-weight: 700; margin-top: 12px;">LET OP!</MudText>
            <MudText Style="margin-top: 8px;">Gebruik deze importeer functie alleen als jouw CSV bron niet in de lijst weergeven staat!</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3" Style="display: flex;">
        <MudPaper Elevation="0" Style="background-color: #e8f0fe; border-radius: 12px; padding: 24px; width: 100%; height: 100%;">
            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Style="color: #3b82f6; font-size: 2rem;" />
            <MudText Typo="Typo.h6" Style="font-weight: 700; margin-top: 12px;">Stroom levering</MudText>
            <MudText Style="margin-top: 8px;">Koppel import aan de kolom welke te maken heeft met het kopen van stroom. <strong>T1 = normaal tarief. T2 = daltarief.</strong></MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3" Style="display: flex;">
        <MudPaper Elevation="0" Style="background-color: #f0fdf4; border-radius: 12px; padding: 24px; width: 100%; height: 100%;">
            <MudIcon Icon="@Icons.Material.Filled.FileDownload" Style="color: #22c55e; font-size: 2rem;" />
            <MudText Typo="Typo.h6" Style="font-weight: 700; margin-top: 12px;">Stroom teruglevering</MudText>
            <MudText Style="margin-top: 8px;">Koppel export aan de kolom welke te maken heeft met het terugleveren van stroom. <strong>T1 = normaal tarief. T2 = daltarief.</strong></MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3" Style="display: flex;">
        <MudPaper Elevation="0" Style="background-color: #fdf2f8; border-radius: 12px; padding: 24px; width: 100%; height: 100%;">
            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Style="color: #a855f7; font-size: 2rem;" />
            <MudText Typo="Typo.h6" Style="font-weight: 700; margin-top: 12px;">Stap 4: Upload</MudText>
            <MudText Style="margin-top: 8px;">Verwerk de CSV. Kom je er niet uit? Neem dan contact met ons op via <strong>i274867@fontysict.nl</strong></MudText>
        </MudPaper>
    </MudItem>
</MudGrid>