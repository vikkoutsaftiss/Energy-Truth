@using MudBlazor

<MudGrid Class="mt-4 mb-6" Style="align-items: stretch;">
    <MudItem xs="12" sm="6" md="3" Style="display: flex;">
        <MudPaper Elevation="0" Style="background-color: #fff8e1; border-radius: 12px; padding: 24px; width: 100%; height: 100%;">
            <MudIcon Icon="@Icons.Material.Filled.Language" Style="color: #f59e0b; font-size: 2rem;" />
            <MudText Typo="Typo.h6" Style="font-weight: 700; margin-top: 12px;">Stap 1: Open UMeter</MudText>
            <MudText Style="margin-top: 8px;">Ga naar <strong>umeter.nl</strong> en log in op je account.</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3" Style="display: flex;">
        <MudPaper Elevation="0" Style="background-color: #e8f0fe; border-radius: 12px; padding: 24px; width: 100%; height: 100%;">
            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Style="color: #3b82f6; font-size: 2rem;" />
            <MudText Typo="Typo.h6" Style="font-weight: 700; margin-top: 12px;">Stap 2: Beheer locaties</MudText>
            <MudText Style="margin-top: 8px;">Ga naar de pagina <strong>Beheer locaties</strong> en zoek je adres op.</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3" Style="display: flex;">
        <MudPaper Elevation="0" Style="background-color: #f0fdf4; border-radius: 12px; padding: 24px; width: 100%; height: 100%;">
            <MudIcon Icon="@Icons.Material.Filled.FileDownload" Style="color: #22c55e; font-size: 2rem;" />
            <MudText Typo="Typo.h6" Style="font-weight: 700; margin-top: 12px;">Stap 3: Exporteer</MudText>
            <MudText Style="margin-top: 8px;">Klik op de <strong>Export</strong> knop naast je adres, kies bij voorkeur een periode van <strong>één jaar of langer</strong> en sla het CSV bestand op.</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3" Style="display: flex;">
        <MudPaper Elevation="0" Style="background-color: #fdf2f8; border-radius: 12px; padding: 24px; width: 100%; height: 100%;">
            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Style="color: #a855f7; font-size: 2rem;" />
            <MudText Typo="Typo.h6" Style="font-weight: 700; margin-top: 12px;">Stap 4: Upload</MudText>
            <MudText Style="margin-top: 8px;">Upload het bestand hieronder.</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>